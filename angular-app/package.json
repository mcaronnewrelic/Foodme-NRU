{
  "name": "angular-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:analyze": "ng build && node analyze-bundle.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
