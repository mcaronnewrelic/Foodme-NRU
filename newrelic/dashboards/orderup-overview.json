{
  "name": "OrderUp Overview",
  "description": "Orders, menus and browser activity for OrderUp. The queries match the 'Behind the scenes' callouts on the site.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Orders",
      "description": "Custom event, attributes and metrics the server records for every order.",
      "widgets": [
        {
          "title": "Orders and revenue",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) AS 'Orders', sum(orderTotal) AS 'Revenue' FROM `Order` WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Orders over time",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 8,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) AS 'Orders' FROM `Order` WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' TIMESERIES AUTO SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Orders by restaurant",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) AS 'Orders' FROM `Order` WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' FACET restaurant SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Revenue by restaurant",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT sum(orderTotal) AS 'Revenue' FROM `Order` WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' FACET restaurant SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Checkout latency (POST /api/order)",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT average(duration) AS 'Average', percentile(duration, 95) AS '95th percentile' FROM Transaction WHERE appName = 'OrderUp' AND name = 'WebTransaction/Expressjs/POST//api/order' TIMESERIES AUTO SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Order metrics (Custom/Orders/*)",
          "layout": {
            "column": 7,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(newrelic.timeslice.value) FROM Metric WHERE appName = 'OrderUp' AND metricTimesliceName IN ('Custom/Orders/count', 'Custom/Orders/total') FACET metricTimesliceName TIMESERIES AUTO SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Failed orders",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM TransactionError WHERE appName = 'OrderUp' AND transactionName = 'WebTransaction/Expressjs/POST//api/order' FACET error.message SINCE 1 week ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Menus and errors",
      "description": "Menu requests, including the planned failure set with DEMO_FAILING_RESTAURANT.",
      "widgets": [
        {
          "title": "Menu requests by status code",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM Transaction WHERE appName = 'OrderUp' AND name = 'WebTransaction/Expressjs/GET//api/restaurant/by-name/:name' FACET http.statusCode TIMESERIES AUTO SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Menu requests by restaurant and status",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM Transaction WHERE appName = 'OrderUp' AND name = 'WebTransaction/Expressjs/GET//api/restaurant/by-name/:name' FACET restaurantSlug, http.statusCode SINCE 1 week ago LIMIT 50"
              }
            ]
          }
        },
        {
          "title": "Menu errors",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*), latest(timestamp) AS 'Last seen' FROM TransactionError WHERE appName = 'OrderUp' AND transactionName = 'WebTransaction/Expressjs/GET//api/restaurant/by-name/:name' FACET restaurantSlug, error.message SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Menu latency by restaurant",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT average(duration) FROM Transaction WHERE appName = 'OrderUp' AND name = 'WebTransaction/Expressjs/GET//api/restaurant/by-name/:name' FACET restaurantSlug SINCE 1 week ago LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Restaurant list latency (GET /api/restaurant)",
          "layout": {
            "column": 7,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT average(duration) AS 'Average', percentile(duration, 95) AS '95th percentile' FROM Transaction WHERE appName = 'OrderUp' AND name = 'WebTransaction/Expressjs/GET//api/restaurant' TIMESERIES AUTO SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Server errors, all routes (planned errors excluded)",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM TransactionError WHERE appName = 'OrderUp' AND transactionName NOT LIKE '%/simulate/%' FACET transactionName, error.message SINCE 1 week ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Browser",
      "description": "What visitors' browsers send: page views, errors, page actions and users.",
      "widgets": [
        {
          "title": "Visitors",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT uniqueCount(session) AS 'Sessions', count(*) AS 'Page views' FROM PageView WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Page views by page",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 8,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM PageView WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' FACET pageUrl SINCE 1 week ago LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "JavaScript errors",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM JavaScriptError WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' FACET errorMessage, page SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Failed AJAX requests (5xx)",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM AjaxRequest WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' AND httpResponseCode >= 500 FACET requestUrl SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Page actions",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM PageAction WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' FACET actionName SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Error simulation round trip (durationMs)",
          "layout": {
            "column": 7,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT average(durationMs), max(durationMs) FROM PageAction WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' AND actionName = 'error_simulation_triggered' TIMESERIES AUTO SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Activity by user (enduser.id)",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM PageView, AjaxRequest, PageAction, JavaScriptError WHERE demoCode NOT LIKE 'SIM-%' AND appName = 'OrderUp' AND enduser.id IS NOT NULL FACET enduser.id, eventType() SINCE 1 week ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Knowledge checks",
      "description": "What the class answered in the mission checks (OrderupQuizAnswer), and \u2014 with your code picked at the top \u2014 your own journey.",
      "widgets": [
        {
          "title": "Answers",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) AS 'Answers', uniqueCount(demoCode) AS 'Visitor codes' FROM OrderupQuizAnswer WHERE demoCode NOT LIKE 'SIM-%' SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Right on the first try",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT percentage(count(*), WHERE demoCode NOT LIKE 'SIM-%' AND outcome = 'correct') AS 'Right on the first try' FROM OrderupQuizAnswer WHERE attempt = 1 SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": null,
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "## Knowledge checks\nEvery answer to a mission check lands here as an `OrderupQuizAnswer` event \u2014 right or wrong, with its attempt number. **Students: pick your code in the variable bar at the top of this dashboard** to fill in the Your journey section below."
          }
        },
        {
          "title": "Answers over time",
          "layout": {
            "column": 1,
            "row": 2,
            "width": 8,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) FROM OrderupQuizAnswer FACET outcome TIMESERIES AUTO WHERE demoCode NOT LIKE 'SIM-%' SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "First-try accuracy by mission",
          "layout": {
            "column": 9,
            "row": 2,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT percentage(count(*), WHERE demoCode NOT LIKE 'SIM-%' AND outcome = 'correct') AS 'Right first try (%)' FROM OrderupQuizAnswer WHERE attempt = 1 FACET missionId SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Hardest questions (most wrong on the first try)",
          "layout": {
            "column": 1,
            "row": 3,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT percentage(count(*), WHERE demoCode NOT LIKE 'SIM-%' AND outcome = 'incorrect') AS 'Wrong first try (%)', count(*) AS 'First tries' FROM OrderupQuizAnswer WHERE attempt = 1 FACET missionId, questionId LIMIT 20 SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Most-picked wrong answers",
          "layout": {
            "column": 7,
            "row": 3,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) AS 'Times picked' FROM OrderupQuizAnswer WHERE demoCode NOT LIKE 'SIM-%' AND outcome = 'incorrect' FACET missionId, questionId, answer LIMIT 20 SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Tries needed to get it right",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT average(attempt) AS 'Average tries', max(attempt) AS 'Most tries' FROM OrderupQuizAnswer WHERE demoCode NOT LIKE 'SIM-%' AND outcome = 'correct' FACET missionId, questionId LIMIT 20 SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Solved on attempt\u2026",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) AS 'Solved' FROM OrderupQuizAnswer WHERE demoCode NOT LIKE 'SIM-%' AND outcome = 'correct' FACET attempt SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": null,
          "layout": {
            "column": 1,
            "row": 5,
            "width": 12,
            "height": 2
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "## Your journey\nThe widgets below answer to the **demoCode variable at the top of this dashboard** \u2014 pick your code (it appears in the list after your first check answer) and they show only your data."
          }
        },
        {
          "title": "Your answers",
          "layout": {
            "column": 1,
            "row": 6,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) AS 'Your answers' FROM OrderupQuizAnswer WHERE demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Your first-try score",
          "layout": {
            "column": 5,
            "row": 6,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT percentage(count(*), WHERE outcome = 'correct') AS 'Right on the first try' FROM OrderupQuizAnswer WHERE attempt = 1 AND demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Your orders",
          "layout": {
            "column": 9,
            "row": 6,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT count(*) AS 'Your orders' FROM `Order` WHERE demoCode NOT LIKE 'SIM-%' AND demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Your answer history",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  1352811
                ],
                "query": "SELECT timestamp, missionId, question, answer, outcome, attempt FROM OrderupQuizAnswer WHERE demoCode = {{demoCode}} LIMIT 50 SINCE 1 week ago"
              }
            ]
          }
        }
      ]
    },
